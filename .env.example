# ==============================================================================
# REI (Repository-Aware AI Agent) - Environment Configuration Example
# ==============================================================================
# Copy this file to .env in your repository root and fill in your desired settings:
# cp .env.example .env
#
# NOTE: .env is per-WORKSPACE — REI loads the .env of the project you run it in (it wins
# over the install's base ~/.rei/.env). So each project can use a different provider/model.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. QUICK-START WORKSPACE EXAMPLES (copy ONE into your project's .env)
# ------------------------------------------------------------------------------
#
# --- A) LOCAL workspace (LM Studio, offline, free) ---------------------------
# NOTE ON THE PREFIX: the provider is named `lmstudio`, but its variables use `LLM_STUDIO_`.
# That is the ONLY spelling the code reads — `LMSTUDIO_MODEL` is silently ignored, which is an
# easy hour to lose. The mismatch is historical: the provider was renamed, the variables were not,
# so that existing .env files kept working.
# MODEL_PROVIDER=lmstudio
# AGENT_MODEL_PROVIDER=
# LLM_STUDIO_MODEL=qwen/qwen3.6-35b-a3b            # ask + planning
# LLM_STUDIO_MODEL_AGENT=qwen/qwen3.6-35b-a3b      # agent
# REI_CONTEXT_WINDOW=61440                         # MUST match the window loaded in LM Studio
# REI_REASONING_EFFORT_ASK=none                    # snappy (binary qwen: none=off)
# REI_PRESERVE_THINKING=false                      # default; re-feeding reasoning loops local models
# REI_EDIT_MODE=direct                             # default; sandbox saturates local agent loops
# REI_ON_DEMAND_FILE_CONTEXT_ASK=1                 # ask/planning: load files on demand (light)
# REI_ON_DEMAND_FILE_CONTEXT_PLANNING=1
# REI_ON_DEMAND_FILE_CONTEXT_AGENT=0               # agent: proactive full context in one turn
# OLLAMA_TEMPERATURE=0                             # (ollama) deterministic ask/planning
# REI_VISION_MODEL=qwen/qwen3-vl-4b                # optional: image input
#
# --- B) CLOUD workspace (OpenRouter, large context, premium models) ----------
# MODEL_PROVIDER=openrouter
# AGENT_MODEL_PROVIDER=                            # leave empty: same provider for all modes
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=qwen/qwen3.6-plus               # ask + planning
# OPENROUTER_MODEL_AGENT=qwen/qwen3.6-plus         # agent
# # REI_CONTEXT_WINDOW left UNSET → REI auto-uses 128000 (cloud default) so it never trims
# # prematurely; the gauge still shows %. For a bigger model: OPENROUTER_CONTEXT_WINDOW=200000
# # reasoning_effort: cloud models pick their own — usually leave it unset.
#
# --- C) HYBRID (local for ask/planning, cloud for agent) ---------------------
# MODEL_PROVIDER=lmstudio
# AGENT_MODEL_PROVIDER=openrouter                  # heavy agent turns go to the cloud
# LLM_STUDIO_MODEL=qwen/qwen3.6-35b-a3b
# OPENROUTER_MODEL_AGENT=qwen/qwen3.6-plus
# OPENROUTER_API_KEY=sk-or-...
# # window auto-resolves from the AGENT provider (openrouter → 128000).

# ------------------------------------------------------------------------------
# 1. PRIMARY ORCHESTRATION & PROVIDERS
# ------------------------------------------------------------------------------

# Main LLM provider for the chat session.
# Supported values: mock, ollama, groq, gemini, openrouter, huggingface, lmstudio, omlx, mtplx, openai-compat
MODEL_PROVIDER=lmstudio

# (Optional) Dedicated provider used ONLY for AGENT mode execution.
# Allows using a light local provider (e.g., ollama) for fast Ask/Planning turns, 
# while delegating heavier XML-producing actions to a premium cloud model.
# E.g., AGENT_MODEL_PROVIDER=openrouter
AGENT_MODEL_PROVIDER=openrouter


# ------------------------------------------------------------------------------
# 2. CLOUD PROVIDER CREDENTIALS & API KEYS
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here


# ------------------------------------------------------------------------------
# 3. CLOUD PROVIDER MODEL SELECTION
# ------------------------------------------------------------------------------

# --- OpenRouter Models ---
# Default model for all modes using OpenRouter
#OPENROUTER_MODEL=qwen/qwen3-coder-30b-a3b-instruct
# Specific model used only in Agent mode (optional)
OPENROUTER_MODEL_AGENT=qwen/qwen3.6-plus

# --- Gemini Models ---
# Default model for all modes using Gemini
GEMINI_MODEL=gemini-2.5-flash
# Specific model used only in Agent mode (optional)
# GEMINI_MODEL_AGENT=gemini-2.5-pro

# --- Groq Models ---
# Default model for all modes using Groq
# Must support tool calling — REI is an agent. Groq's live list: https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.8-27b
# Specific model used only in Agent mode (optional)
# GROQ_MODEL_AGENT=deepseek-r1-distill-llama-70b

# --- Cloud request timeouts (ms, all default to 120000) ---
# OPENROUTER_REQUEST_TIMEOUT_MS=120000
# GEMINI_REQUEST_TIMEOUT_MS=120000
# GROQ_REQUEST_TIMEOUT_MS=120000


# ------------------------------------------------------------------------------
# 4. LOCAL PROVIDER MODEL SELECTION
# ------------------------------------------------------------------------------

# --- Ollama Configuration ---
# Model for ask + planning modes.
OLLAMA_MODEL=qwen2.5-coder:14b
# Dedicated agent-mode model (optional). Falls back to OLLAMA_MODEL.
# OLLAMA_MODEL_AGENT=qwen3.6:27b-coding-nvfp4
#
# Model selection is uniform across ALL providers: <PROVIDER>_MODEL is the default for every mode,
# and <PROVIDER>_MODEL_ASK / _PLANNING / _AGENT override it per mode when you set them.

# --- LM Studio Configuration (lmstudio) ---
LLM_STUDIO_MODEL=qwen/qwen3.6-35b-a3b
# Specific model used only in Agent mode (optional)
# LLM_STUDIO_MODEL_AGENT=meta-llama-3-8b-instruct
# Endpoint + auth (defaults: http://localhost:1234/v1 and the dummy key "lm-studio")
# LLM_STUDIO_BASE_URL=http://localhost:1234/v1
# LLM_STUDIO_API_KEY=lm-studio
# set Timeout here (default 600000 = 10 min)
LLM_STUDIO_REQUEST_TIMEOUT_MS=600000

# --- oMLX Configuration (omlx) ---
# MLX server on Apple Silicon. It can load the models LM Studio already downloaded — point it at
# that cache instead of downloading them twice.
# OMLX_MODEL=qwen/qwen3.8-27b
# OMLX_MODEL_AGENT=qwen/qwen3.8-27b
# OMLX_BASE_URL=http://127.0.0.1:8000/v1        # this is the default
# OMLX_API_KEY=                                  # most local servers need none
# OMLX_REQUEST_TIMEOUT_MS=600000
# Sampling, when you want to override the model's own tuning in rei.config.json:
# OMLX_TEMPERATURE=0.7                           # default
# OMLX_FREQUENCY_PENALTY=0                       # default
# OMLX_PRESENCE_PENALTY=0                        # default
# Forward thinking controls inside chat_template_kwargs (the Qwen3 templates read them there).
# ON by default for oMLX; set to 0 if your server rejects the field.
# OMLX_TEMPLATE_KWARGS=1

# --- Generic OpenAI-compatible endpoint (openai-compat) ---
# vLLM, llama.cpp, LocalAI, a self-hosted gateway — anything speaking OpenAI /v1 with nothing
# provider-specific added.
# OPENAI_COMPAT_MODEL=your-model-id
# OPENAI_COMPAT_MODEL_AGENT=your-model-id
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1   # this is the default
# OPENAI_COMPAT_API_KEY=                            # empty unless your gateway needs one
# OPENAI_COMPAT_REQUEST_TIMEOUT_MS=600000
# OPENAI_COMPAT_TEMPERATURE=0.7                     # default
# OPENAI_COMPAT_FREQUENCY_PENALTY=0                 # default
# OPENAI_COMPAT_PRESENCE_PENALTY=0                  # default
# OFF by default here: an unknown server is likelier to reject chat_template_kwargs than to read it.
# OPENAI_COMPAT_TEMPLATE_KWARGS=1

# --- Vision sidecar (image input) ---
# When you drag/paste an image path into the chat, REI sends the image to a vision model
# in a SEPARATE call and injects its text description into the prompt; the main/coding
# model stays text-only. Needs a vision-capable model (LM Studio tags it "can process
# image inputs" / shows an eye icon).
#
# RECOMMENDED: run a SMALL dedicated vision model so your big coding model isn't loaded
# twice. Uncomment the line below and load qwen3-vl-4b in LM Studio at ~8192 context
# (16384 only for 4K screenshots) — it only ever sees one image + a short prompt, so it
# does NOT need the big REI_CONTEXT_WINDOW (that's for the coding model).
# REI_VISION_MODEL=qwen/qwen3-vl-4b
#
# If REI_VISION_MODEL is left unset, the sidecar falls back to LLM_STUDIO_MODEL — only
# works if THAT model is vision-capable, and it double-loads the heavy model.
#
# PER-PROVIDER: <PROVIDER>_MODEL_VISION wins over REI_VISION_MODEL when that provider is the
# active one, so you can declare one per backend and stop editing this file every time
# MODEL_PROVIDER changes. Same prefixes as <PROVIDER>_MODEL (LLM_STUDIO, OMLX, OLLAMA, …).
# OMLX_MODEL_VISION=Qwen3-VL-8B-MLX-4bit
# LLM_STUDIO_MODEL_VISION=qwen/qwen3-vl-4b
#
# Endpoint + auth for the vision call. Unset, it follows the ACTIVE provider
# (<PROVIDER>_BASE_URL / <PROVIDER>_API_KEY), then LLM_STUDIO_BASE_URL, then local LM Studio.
# Following the provider is what keeps the model and the address in step: a model named in
# OMLX_MODEL_VISION has to be POSTed to oMLX, not to LM Studio, which 404s on an id it does not
# know. Set these explicitly only for a DEDICATED vision server.
# REI_VISION_BASE_URL=http://localhost:1234/v1
# REI_VISION_API_KEY=lm-studio
LLM_STUDIO_FREQUENCY_PENALTY = 0.3
LLM_STUDIO_PRESENCE_PENALTY = 0.3
LLM_STUDIO_TEMPERATURE = 0.3
# Repetition penalty (default 1.1, range 1–2). Higher = less verbatim repeating.
# LLM_STUDIO_REPEAT_PENALTY = 1.1
# Output token cap. LEGACY fallback — prefer REI_MAX_OUTPUT_TOKENS (section 5),
# which takes precedence. Keep >= 8192: 4096 truncates long tool calls mid-edit.
# LLM_STUDIO_MAX_TOKENS = 8192


# --- Hugging Face Inference API Models ---
# Must support tool calling: most HF Inference models do NOT, and reject `tools` with a 422.
HF_MODEL=Qwen/Qwen3-32B
# Specific model used only in Agent mode (optional)
# HF_MODEL_AGENT=Qwen/Qwen2.5-Coder-32B-Instruct
# Request timeout (ms, default 120000)
# HF_REQUEST_TIMEOUT_MS=120000
# Output token cap. LEGACY fallback — prefer REI_MAX_OUTPUT_TOKENS (section 5).
# HF_MAX_TOKENS=8192


# ------------------------------------------------------------------------------
# 5. CONTEXT & TOKEN BUDGET (UNIFIED — provider-agnostic)
# ------------------------------------------------------------------------------
# Single source of truth for REI's context/token budget, resolved in
# src/config/model-runtime.ts. These provider-agnostic REI_* vars take
# precedence over the legacy provider-specific names (OLLAMA_NUM_CTX,
# LLM_STUDIO_MAX_TOKENS, OLLAMA_NUM_PREDICT, HF_MAX_TOKENS), which are still
# honored only as fallbacks. Set them HERE and they apply to every provider.

# Total context window REI assumes for trimming (input + output tokens).
# Leave UNSET / 0 = unknown → REI does no trimming (and, for Ollama, lets the
# model use its own loaded num_ctx). For LM Studio the real window is set in its
# UI — this is only REI's budgeting assumption, so keep both in sync.
# Thinking models (Qwen 3.6, DeepSeek R1): 16384–60000 to avoid window exhaustion.
# REI_CONTEXT_WINDOW=60000
#
# CLOUD PROVIDERS: if REI_CONTEXT_WINDOW is UNSET, REI auto-uses a large per-provider
# default (openrouter/gemini/groq = 128000, hf = 32000) so cloud models aren't trimmed
# prematurely and the gauge still shows. Override per provider for a model with a different
# window (e.g. a 200K or 1M model, or a small one to avoid overflow):
# OPENROUTER_CONTEXT_WINDOW=200000
# GEMINI_CONTEXT_WINDOW=1000000
# Local providers (lmstudio/ollama) with no explicit value → 0 = no trimming (set
# REI_CONTEXT_WINDOW to the loaded window for budgeting + the gauge).

# Max output tokens. ONE value used both as the provider's hard generation cap
# AND as the budget's response reserve, so what REI reserves always equals what
# the model can actually emit. Keep >= 8192 (4096 truncates long tool calls).
# REI_MAX_OUTPUT_TOKENS=8192

# Max iterations of the agent tool-calling loop within a single turn (default 12).
REI_MAX_TURNS=13

# Per-mode reasoning budget (OpenAI-standard `reasoning_effort`, honored by LM Studio).
# Values: none | minimal | low | medium | high | xhigh. "none" disables the thinking phase;
# unset = the model's own default. Lets you keep agent turns thinking while making
# ask/planning snappy, without flipping LM Studio's global toggle.
# CAVEAT: granular levels only matter on models that support them. Some models are BINARY
# (e.g. qwen3.6-35b-a3b): they map none→off and low/medium/high→on, so there's no middle —
# only "none" (off) vs full thinking. For those, pick none (fast) or omit the var (full).
# Recommended (graduated models): ask=none, planning=low, agent=medium.
# REI_REASONING_EFFORT_ASK=none
# REI_REASONING_EFFORT_PLANNING=low
# REI_REASONING_EFFORT_AGENT=medium

# --- Agent/tools sampling (anti-loop) ---------------------------------------
# Sampling for the agent/tools path (native function-calling), provider-agnostic
# (Ollama / OpenRouter / LM Studio / Groq). This path used to decode GREEDILY
# (temperature 0) — the #1 cause of repetition loops on local models. Defaults now
# add a mild temperature + repetition penalties to break loops at the source.
#   - Penalties are only sent when > 0 (set to 0 to omit them entirely).
#   - For deterministic tool-calls on cloud, set REI_AGENT_TEMPERATURE=0.
#   - Loops still happening? raise REI_AGENT_FREQUENCY_PENALTY toward 0.5.
# REI_AGENT_TEMPERATURE=0.3
# REI_AGENT_FREQUENCY_PENALTY=0.3
# REI_AGENT_PRESENCE_PENALTY=0.3


# ------------------------------------------------------------------------------
# 6. OLLAMA ENGINE PERFORMANCE TUNING (ADVANCED)
# ------------------------------------------------------------------------------

# Base URL to reach the Ollama API (defaults to http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Temperature for the Ollama NATIVE /api/chat path (ask / XML, non-tools).
# Leave UNSET → default 0.6 + repetition penalties (anti-loop, matches LM Studio).
# DO NOT set 0 here: greedy decoding (temp 0) is the #1 cause of repetition loops on
# local models — the old "0 for deterministic XML" advice predates the loop fix.
# (The agent/tools path is separate and uses REI_AGENT_TEMPERATURE — see section 5.)
# OLLAMA_TEMPERATURE=0.6

# Repetition controls (frequency/presence default 0.3; repeat is unset by default).
# OLLAMA_FREQUENCY_PENALTY=0.3
# OLLAMA_PRESENCE_PENALTY=0.3
# OLLAMA_REPEAT_PENALTY=1.1

# LEGACY fallbacks — prefer REI_CONTEXT_WINDOW / REI_MAX_OUTPUT_TOKENS (section 5),
# which take precedence. Kept so existing Ollama-only .env files keep working.
#OLLAMA_NUM_CTX=60000
#OLLAMA_NUM_PREDICT=8192

# Number of CPU threads to allocate for local inference
# OLLAMA_NUM_THREAD=8

# Duration to keep models loaded in Ollama's memory (defaults to 30m)
# OLLAMA_KEEP_ALIVE=2h

# Network request timeout in milliseconds for local Ollama completions (defaults to 300000)
# OLLAMA_REQUEST_TIMEOUT_MS=600000


# ------------------------------------------------------------------------------
# 7. CONTEXT REDUCTION & PERFORMANCE OPTIMIZATIONS
# ------------------------------------------------------------------------------

# Master toggle for on-demand context injection (1 = Enabled, 0 = Disabled).
# When enabled, files are only loaded when explicitly referenced by the user (e.g. @filename),
# keeping prompt context small, fast, and highly resource-efficient for local execution.
REI_ON_DEMAND_FILE_CONTEXT=1

# Mode-specific overrides (optional). Default is now on-demand for ALL modes (ask/planning/agent):
# the model discovers repo structure with tools (ls/grep/read_file) instead of REI injecting a large
# skeleton map — essential for big repos. Uncomment + set a mode to 0 to force it back to PROACTIVE
# full-context injection (repo map + file tree). Leaving these commented lets the code default govern.
# REI_ON_DEMAND_FILE_CONTEXT_ASK=1
# REI_ON_DEMAND_FILE_CONTEXT_PLANNING=1
# REI_ON_DEMAND_FILE_CONTEXT_AGENT=0


# ------------------------------------------------------------------------------
# 8. WORKSPACE, SERVER & TOOL SETTINGS
# ------------------------------------------------------------------------------

# Default directory path to target upon starting the chat
# REI_WORKSPACE_PATH=/path/to/your/default/workspace

# List of authorized directories for the server backend (comma-separated)
# ALLOWED_WORKSPACES=/path/to/project1,/path/to/project2

# Additional commands allowed by the run_command sandbox (comma-separated).
# These are ALLOWED on top of the static built-in set. Empty by default — only what
# you explicitly list here is permitted, so the sandbox stays closed for new projects.
# Each entry is validated as a safe identifier (letters, digits, dashes, underscores).
# Example: REI_ALLOWED_COMMANDS=engram,rtk
# REI_ALLOWED_COMMANDS=

# Model used specifically to summarize historical messages during session compaction.
# LEAVE BOTH UNSET (recommended): compaction then reuses the model the session is already
# running on — no second model to load, no swap, and its cached prefix stays warm.
#
# Set one only when you want a different summariser. A model id belongs to ONE backend, so a
# single COMPACTOR_MODEL breaks the moment MODEL_PROVIDER changes (an LM Studio id against oMLX
# 404s, compaction is skipped, and the session sails past its window). <PROVIDER>_MODEL_COMPACTOR
# wins over the global for the active provider, which is how both can coexist.
# COMPACTOR_MODEL=qwen3:4b
# OMLX_MODEL_COMPACTOR=Qwen3.6-4B-MLX-4bit
# LLM_STUDIO_MODEL_COMPACTOR=qwen3:4b

# Test-Driven Development (TDD) Mode (true/false). DEFAULT: false (recommended).
# The compile/type-check (tsc / ngc / dotnet build / …) ALWAYS runs as the verify gate. With
# TDD on, REI also appends `&& npm run test`, so the verify passes only if the FULL test suite
# passes. Keep it false unless your suite is green, fast and reliable AND the task is
# logic/behavior-heavy — otherwise a single unrelated or flaky failing test makes a CORRECT
# change report "not verified" and triggers pointless self-correction. With it off you don't
# lose test coverage: the model can still run `npm test` on demand when a change warrants it.
REI_TDD_MODE=false

# Code Modification Formatting Scheme (sr | wholefile)
# - sr (default): Emits search-replace tags (<search> / <replace>), highly efficient for large files.
# - wholefile: Emits the complete file replacement within the <edit> tag.
# AGENT_EDIT_FORMAT=sr

# Agent edit application mode (direct | sandbox). DEFAULT: direct.
# - direct  (recommended): apply edits straight to disk with NO per-edit compile-check. The
#           model self-verifies via run_command (it sees the real disk) and REI runs ONE final
#           verify when it finishes (with self-correction). Light + loop-free — best for local
#           models. Trade-off: partial edits remain on disk if the task aborts (recover via git).
# - sandbox (legacy/strict): validate every edit against a cumulative throwaway sandbox and
#           persist only green state — never leaves broken code on disk, but copies the
#           workspace per edit and tends to saturate local models' agent loops.
# REI_EDIT_MODE=direct

# Skip AST/type validation of wholefile edits before applying (true/false, default false).
# Only enable if validation is too slow and you trust the model's output.
# REI_WHOLEFILE_SKIP_VALIDATE=false

# Override the command the sandbox runs to verify edits (defaults to the
# auto-detected one per project type, e.g. `npx tsc --noEmit`).
# REI_SANDBOX_VERIFY_COMMAND=npm run typecheck

# Preserve <think>/reasoning across turns by re-sending it to the model (true/false,
# default false). Keep it OFF for local models: re-fed reasoning ACCUMULATES across the
# tools loop and the model echoes its own prior thoughts, causing repetition loops (the
# same command/tool re-issued many times). Reasoning models regenerate reasoning fresh, so
# there's no loss. Opt in (=true) only for a model that demonstrably benefits — and note
# Anthropic/Bedrock REQUIRE it ON (the thinking block + signature must be preserved on
# replay, else HTTP 400). See preserveThinkingEnabled() in src/config/model-runtime.ts.
# REI_PRESERVE_THINKING=false

# Tool-RAG: when an MCP server exposes many tools (> 25), REI hides them behind a
# `search_tools` meta-tool the model calls on demand (keyword search, no embeddings),
# instead of injecting every schema and overflowing context.
# Default: enabled (kicks in only when > 25 MCP tools are connected).
# Set to "false" to always inject every tool schema regardless of count.
# REI_TOOL_RAG=false

# --- RAG embedder (parametrizable) ------------------------------------------
# Model that turns code/text into vectors for semantic search. This is an EMBEDDING model,
# NOT a chat LLM — small + specialized. Default: in-process Xenova MiniLM (~22MB, zero-config,
# English-centric). For multilingual docs (Spanish, etc.) point it at a server embedding model.
# NOTE: changing the embedder changes the vector dimension → REI auto-reindexes (stored index
# is stamped with the embedder id). Index + query always use the same embedder.
# REI_EMBEDDER_PROVIDER=xenova        # xenova (default) | lmstudio | ollama | openai
# REI_EMBEDDER_MODEL=bge-m3           # required for server backends (a multilingual EMBEDDING model)
# REI_EMBEDDER_BASE_URL=http://127.0.0.1:1234/v1   # LM Studio /v1 (or cloud)
# REI_EMBEDDER_API_KEY=               # if the server needs one

# HTTP port for the REI server backend (default 3000).
# REI_SERVER_PORT=3000

# MCP per-tool call timeouts (ms): single call (default 30000) and total incl.
# retries (default 60000).
# MCP_TOOL_TIMEOUT_MS=30000
# MCP_TOOL_MAX_TIMEOUT_MS=60000

# NOTE: the context/token budget (REI_CONTEXT_WINDOW, REI_MAX_OUTPUT_TOKENS,
# REI_MAX_TURNS) now lives in section 5 — CONTEXT & TOKEN BUDGET.

# ------------------------------------------------------------------------------
# 9. LAMINAR: AGENT OBSERVABILITY
# ------------------------------------------------------------------------------

LMNR_PROJECT_API_KEY=your-key-here
LMNR_BASE_URL=http://localhost
LMNR_GRPC_PORT=8001


#REI_SUBAGENT_ENABLED=true