{
  "name": "rei",
  "version": "0.1.0",
  "description": "A personal AI agent CLI",
  "author": "Lucas Aguilar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasaguilar/rei.git"
  },
  "keywords": [
    "ai",
    "agent",
    "ast",
    "rag",
    "cli",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "rei": "./bin/rei.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "check": "tsc --noEmit",
    "log:viewer": "node tools/log-viewer/server.mjs",
    "live": "npx live-server --config=live-server.config.json",
    "server": "node dist/server.js",
    "server:dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:eval": "tsx scripts/rag-eval.ts",
    "test:speed": "tsx scripts/test_speed.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^5.0.0",
    "diff": "^8.0.4",
    "dotenv": "^17.4.2",
    "jsonrepair": "^3.13.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.19.2",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
