# API Keys for different LLM providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# Default Workspace Configuration
REI_WORKSPACE_PATH=/path/to/your/default/workspace

# AI Model Configuration
MODEL_PROVIDER=openrouter
OPENROUTER_MODEL=qwen/qwen3-coder-30b-a3b-instruct

# Ollama model configuration
# OLLAMA_MODEL is used as the default for all modes
# Per-mode overrides (optional) — fall back to OLLAMA_MODEL if not set
# OLLAMA_MODEL=qwen2.5-coder:14b
# OLLAMA_MODEL_AGENT=qwen3:30b-a3b      # Agent mode: heavier model for XML edits
# OLLAMA_MODEL_ASK=gemma3:12b           # Ask mode: fast, conversational
# OLLAMA_MODEL_PLANNING=gemma3:12b      # Planning mode: fast, structured

# Optional: List of allowed workspaces for the REI server (comma separated)
ALLOWED_WORKSPACES=/path/to/project1,/path/to/project2
